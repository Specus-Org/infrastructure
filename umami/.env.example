# =============================================================================
# UMAMI WEB ANALYTICS CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to git (it contains sensitive data).
#
# Usage: docker-compose --env-file .env up -d
# =============================================================================

# Umami version (pinned for reproducibility)
UMAMI_VERSION=postgresql-latest

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Uses PostgreSQL from core stack. Provision with init-umami.sql first.

UMAMI_DB_HOST=specus-production-database-rkpsij
UMAMI_DB_PORT=5432
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami_user

# Must match what was set in init-umami.sql
# Generate with: openssl rand -base64 32
# Avoid URL-reserved characters (: / @ ? # [ ] !) or URL-encode them.
UMAMI_DB_PASSWORD=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Secret for signing sessions — rotate to invalidate all active sessions.
# Generate with: openssl rand -base64 32
UMAMI_APP_SECRET=
